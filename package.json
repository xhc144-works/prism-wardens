{
  "name": "prism-wardens",
  "productName": "Prism Wardens",
  "version": "1.0.0",
  "description": "棱镜守卫 Prism Wardens — 原创策略塔防游戏，内置修改器、AI 自动游玩/研究与自定义挑战规则",
  "author": "Prism Wardens Team",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sim": "tsx cli/sim.ts",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
